APP_NAME=Decentralized Voting API
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1

BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
EXPECTED_CHAIN_ID=1337
DEPLOYMENT_FILE=../deployments/localhost.json

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Generate your own random administrative token (never commit the real value).
ADMIN_API_TOKEN=replace_with_a_random_admin_token

# Use independent, strong passphrases of at least 12 characters.
IDENTITY_VAULT_PASSPHRASE=replace_with_a_strong_identity_passphrase
ELECTION_KEY_PASSPHRASE=replace_with_a_strong_election_key_passphrase
